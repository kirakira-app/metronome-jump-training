rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/settings/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/images/{imageId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['dataUrl', 'type', 'createdAt'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 900000
        && request.resource.data.type in ['char', 'bg'];
    }
  }
}
